# Public Supabase keys only — never put the service-role key or other secrets here.
# RLS must allow anon INSERT on waitlist only. Do not grant SELECT (or UPDATE/DELETE) to anon.
# Apply docs/supabase-waitlist.sql in the Supabase SQL editor.
# If public.waitlist already exists, run docs/supabase-waitlist-source.sql
# before deploying. Inserts that send source columns fail until it has run.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
