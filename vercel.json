{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "projectlandingpage.vercel.app"
        }
      ],
      "destination": "https://www.velaquote.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/keepalive",
      "schedule": "0 6 * * *"
    }
  ]
}
